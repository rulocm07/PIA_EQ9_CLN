# Copiar a .env y RELLENAR; no incluir credenciales reales en Git.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL_FUERTE
POSTGRES_DB=hotel
# Script scripts/generate_admin_pin.py produce el hash a partir de un PIN elegido por el equipo.
# Pegar salida de scripts/generate_admin_pin.py, p. ej. ADMIN_PIN_HASH='250000$salt$hash'
ADMIN_PIN_HASH=
# Tokens largos, aleatorios y diferentes para los roles de la demostración.
ROLE_TOKEN_ADMIN=
ROLE_TOKEN_MAINTENANCE=
# Rangos de Semana Santa validados por el equipo: YYYY-MM-DD:YYYY-MM-DD[,..]
HOLY_WEEK_RANGES=
